 }
 
+TEST(session_generations_are_global_across_authorities) {
+        _cleanup_(oomd_reporter_lifecycle_freep) OomdReporterLifecycle *lifecycle = NULL;
+        OomdReporterAuthority other_user = {
+                .kind = OOMD_REPORTER_USER_MANAGER,
+                .uid = 4712,
+        };
+        OomdReporterAuthority system = {
+                .kind = OOMD_REPORTER_SYSTEM_MANAGER,
+                .uid = 0,
+        };
+        OomdReporterLifecycleTransition transition;
+        OomdReporterSession first, second, third;
+
+        ASSERT_OK(oomd_reporter_lifecycle_new(&lifecycle));
+        first = begin_session(lifecycle);
+        second = begin_authority(lifecycle, other_user);
+        third = begin_authority(lifecycle, system);
+        ASSERT_GT(second.generation, first.generation);
+        ASSERT_GT(third.generation, second.generation);
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 3U);
+
+        ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, first, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, second, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, third, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 0U);
+}
+
+TEST(dormant_authority_state_is_collected_without_token_reuse) {
+        _cleanup_(oomd_reporter_lifecycle_freep) OomdReporterLifecycle *lifecycle = NULL;
+        OomdReporterLifecycleTransition transition;
+        OomdReporterSession old, fresh;
+
+        ASSERT_OK(oomd_reporter_lifecycle_new(&lifecycle));
+        old = activate_session(lifecycle);
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 1U);
+
+        ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, old, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 0U);
+
+        fresh = begin_session(lifecycle);
+        ASSERT_GT(fresh.generation, old.generation);
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 1U);
+        ASSERT_EQ(oomd_reporter_lifecycle_accepts_incremental(lifecycle, old), 0);
+        ASSERT_ERROR(oomd_reporter_lifecycle_prepare_snapshot(lifecycle, old, &transition), ESTALE);
+
+        ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, old, &transition));
+        ASSERT_EQ(transition.kind, OOMD_REPORTER_LIFECYCLE_TRANSITION_NONE);
+        ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 1U);
+
+        ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, fresh, &transition));
+        ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+        ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 0U);
+}
+
+TEST(uid_churn_does_not_accumulate_dormant_states) {
+        _cleanup_(oomd_reporter_lifecycle_freep) OomdReporterLifecycle *lifecycle = NULL;
+        OomdReporterLifecycleTransition transition;
+        OomdReporterSession session;
+
+        ASSERT_OK(oomd_reporter_lifecycle_new(&lifecycle));
+        for (uint32_t uid = 1; uid <= 1000; uid++) {
+                OomdReporterAuthority authority = {
+                        .kind = OOMD_REPORTER_USER_MANAGER,
+                        .uid = uid,
+                };
+
+                session = begin_authority(lifecycle, authority);
+                ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 1U);
+                ASSERT_OK(oomd_reporter_lifecycle_prepare_disconnect(lifecycle, session, &transition));
+                ASSERT_OK(oomd_reporter_lifecycle_commit(lifecycle, &transition));
+                ASSERT_EQ(oomd_reporter_lifecycle_size(lifecycle), 0U);
+        }
+}
