diff --git a/src/oom/oomd-reporter-adapter.c b/src/oom/oomd-reporter-adapter.c
--- a/src/oom/oomd-reporter-adapter.c
+++ b/src/oom/oomd-reporter-adapter.c
@@ -73,5 +73,52 @@ static OomdReporterAuthorityState *find_authority(
         return NULL;
 }
 
+static bool authority_has_links(
+                OomdReporterAdapter *adapter,
+                OomdReporterAuthority authority) {
+
+        assert(adapter);
+
+        FOREACH_ARRAY(link, adapter->links, adapter->n_links)
+                if (authority_equal(link->session.authority, authority))
+                        return true;
+
+        return false;
+}
+
+static void remove_authority(
+                OomdReporterAdapter *adapter,
+                OomdReporterAuthorityState *state) {
+
+        size_t i;
+
+        assert(adapter);
+        assert(state);
+        assert(state >= adapter->authorities);
+        assert(state < adapter->authorities + adapter->n_authorities);
+
+        i = (size_t) (state - adapter->authorities);
+        adapter->authorities[i] = adapter->authorities[--adapter->n_authorities];
+        if (adapter->n_authorities == 0)
+                adapter->authorities = mfree(adapter->authorities);
+}
+
+static void collect_authority_if_dormant(
+                OomdReporterAdapter *adapter,
+                OomdReporterAuthorityState *state) {
+
+        assert(adapter);
+        assert(state);
+
+        if (state->active_link_id != 0 ||
+            state->pending_link_id != 0 ||
+            state->active_connected ||
+            state->grace_armed ||
+            authority_has_links(adapter, state->authority))
+                return;
+
+        remove_authority(adapter, state);
+}
+
 static bool link_id_referenced(OomdReporterAdapter *adapter, OomdReporterLinkId link_id) {
         assert(adapter);
@@ -308,10 +355,12 @@ int oomd_reporter_adapter_disconnect(
                 state->grace_armed = false;
                 state->grace_session = (OomdReporterSession) {};
                 remove_link(adapter, link_id);
+                collect_authority_if_dormant(adapter, state);
                 return 0;
         }
 
         if (!was_active) {
                 remove_link(adapter, link_id);
+                collect_authority_if_dormant(adapter, state);
                 return 0;
         }
@@ -319,5 +368,6 @@ int oomd_reporter_adapter_disconnect(
                 state->grace_armed = false;
                 state->grace_session = (OomdReporterSession) {};
                 remove_link(adapter, link_id);
+                collect_authority_if_dormant(adapter, state);
                 return 0;
         }
@@ -374,3 +424,9 @@ size_t oomd_reporter_adapter_size(OomdReporterAdapter *adapter) {
 
         return oomd_reporter_registry_size(adapter->registry);
 }
+
+size_t oomd_reporter_adapter_authority_size(OomdReporterAdapter *adapter) {
+        assert(adapter);
+
+        return adapter->n_authorities;
+}
