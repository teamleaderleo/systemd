 DEFINE_TRIVIAL_CLEANUP_FUNC(OomdReporterAdapter*, oomd_reporter_adapter_free);
diff --git a/src/oom/test-oomd-reporter-adapter-reuse.c b/src/oom/test-oomd-reporter-adapter-reuse.c
--- a/src/oom/test-oomd-reporter-adapter-reuse.c
+++ b/src/oom/test-oomd-reporter-adapter-reuse.c
@@ -78,4 +78,79 @@ TEST(disconnected_active_id_remains_reserved_until_grace_resolves) {
         ASSERT_GT(reused.generation, active.generation);
 }
 
+TEST(dormant_authority_records_are_collected) {
+        _cleanup_(oomd_reporter_adapter_freep) OomdReporterAdapter *adapter = NULL;
+        OomdReporterAdapterEvent event;
+        OomdReporterSession first, second;
+
+        ASSERT_OK(oomd_reporter_adapter_new(&adapter));
+
+        ASSERT_OK(oomd_reporter_adapter_connect(
+                          adapter, 1, user_authority, &first, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 1U);
+        ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, 1, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 0U);
+
+        ASSERT_OK(oomd_reporter_adapter_connect(
+                          adapter, 1, user_authority, &second, &event));
+        ASSERT_GT(second.generation, first.generation);
+        activate_link(adapter, 1, 6000);
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 1U);
+        ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, 1, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 0U);
+}
+
+TEST(uid_churn_does_not_accumulate_adapter_authorities) {
+        _cleanup_(oomd_reporter_adapter_freep) OomdReporterAdapter *adapter = NULL;
+        OomdReporterAdapterEvent event;
+        OomdReporterSession session;
+
+        ASSERT_OK(oomd_reporter_adapter_new(&adapter));
+
+        for (uint32_t uid = 1; uid <= 1000; uid++) {
+                OomdReporterAuthority authority = {
+                        .kind = OOMD_REPORTER_USER_MANAGER,
+                        .uid = uid,
+                };
+
+                ASSERT_OK(oomd_reporter_adapter_connect(
+                                  adapter, uid, authority, &session, &event));
+                ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 1U);
+                ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, uid, &event));
+                ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 0U);
+        }
+}
+
+TEST(authority_is_retained_while_grace_references_disconnected_active) {
+        _cleanup_(oomd_reporter_adapter_freep) OomdReporterAdapter *adapter = NULL;
+        OomdReporterAdapterEvent event;
+        OomdReporterSession active, pending;
+
+        ASSERT_OK(oomd_reporter_adapter_new(&adapter));
+        ASSERT_OK(oomd_reporter_adapter_connect(adapter, 1, user_authority, &active, &event));
+        activate_link(adapter, 1, 7000);
+        ASSERT_OK(oomd_reporter_adapter_connect(adapter, 2, user_authority, &pending, &event));
+        ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, 1, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 1U);
+        ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, 2, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 0U);
+}
+
+TEST(superseded_pending_link_keeps_authority_until_last_disconnect) {
+        _cleanup_(oomd_reporter_adapter_freep) OomdReporterAdapter *adapter = NULL;
+        OomdReporterAdapterEvent event;
+        OomdReporterSession first, second;
+
+        ASSERT_OK(oomd_reporter_adapter_new(&adapter));
+        ASSERT_OK(oomd_reporter_adapter_connect(adapter, 1, user_authority, &first, &event));
+        ASSERT_OK(oomd_reporter_adapter_connect(adapter, 2, user_authority, &second, &event));
+        ASSERT_GT(second.generation, first.generation);
+
+        ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, 2, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 1U);
+
+        ASSERT_OK(oomd_reporter_adapter_disconnect(adapter, 1, &event));
+        ASSERT_EQ(oomd_reporter_adapter_authority_size(adapter), 0U);
+}
+
 DEFINE_TEST_MAIN(LOG_DEBUG);
